{
  "name": "accthub",
  "version": "2.0.0",
  "description": "基于 Cloudflare Workers + D1 的全栈多级代理自动发卡与数字商品交易系统",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.19.0",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "install:verify": "node scripts/verify-clean-install.mjs",
    "gate:commit": "node scripts/verify-clean-install.mjs --staged",
    "audit:dependencies": "node scripts/dependency-audit.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "arch:check": "node scripts/arch-guard.mjs",
    "check:commit-msg": "node scripts/check-commit-msg.mjs",
    "prepare": "node -e \"const fs=require('node:fs'),cp=require('node:child_process');if(fs.existsSync('.git'))cp.execFileSync('git',['config','core.hooksPath','.githooks'],{stdio:'ignore'})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run arch:check && pnpm run test && pnpm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate-db.mjs --local",
    "db:init:prod": "node scripts/init-prod.mjs",
    "deploy:preflight": "node scripts/preflight-deploy.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.1",
    "dompurify": "^3.4.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.7.4",
    "lucide-react": "^0.487.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20250327.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.17",
    "@types/dompurify": "^3.2.0",
    "@types/node": "24.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.0.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.6.0"
  }
}
